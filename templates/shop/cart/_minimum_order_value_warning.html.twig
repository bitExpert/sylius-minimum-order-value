{% set cart = bitexpert_minimum_order_value_cart() %}
{% set minimum_order_value = cart is not null ? cart.channel.minimumOrderValue|default(null) : null %}
{# Cart totals are stored in the smallest currency unit (e.g. cents); the minimum order value is in major units. #}
{% set minimum_order_value_amount = minimum_order_value is not null ? (minimum_order_value * 100)|round : null %}

{% if cart is not null and minimum_order_value_amount is not null and cart.total < minimum_order_value_amount %}
    <div class="alert alert-warning mb-4" role="alert">
        <span class="d-flex align-items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-alert-triangle" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 9v2m0 4v.01"/><path d="M5 19h14a2 2 0 0 0 1.84 -2.75l-7.1 -12.25a2 2 0 0 0 -3.5 0l-7.1 12.25a2 2 0 0 0 1.75 2.75"/></svg>
            <span>
                {{ 'bitexpert_sylius_minimum_order_value.shop.cart.warning'|trans({
                    '%minimum_order_value%': minimum_order_value_amount|sylius_format_money(cart.currencyCode, cart.localeCode),
                    '%order_total%': cart.total|sylius_format_money(cart.currencyCode, cart.localeCode),
                }) }}
            </span>
        </span>
    </div>
{% endif %}
