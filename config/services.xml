<?xml version="1.0" encoding="UTF-8" ?>
<container
        xmlns="http://symfony.com/schema/dic/services"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <service id="BitExpert\SyliusMinimumOrderValuePlugin\Checker\MinimumOrderValueChecker" />
        <service id="BitExpert\SyliusMinimumOrderValuePlugin\Checker\MinimumOrderValueCheckerInterface"
                 alias="BitExpert\SyliusMinimumOrderValuePlugin\Checker\MinimumOrderValueChecker" />

        <service id="BitExpert\SyliusMinimumOrderValuePlugin\Form\Extension\ChannelTypeExtension">
            <tag name="form.type_extension" />
        </service>

        <service id="BitExpert\SyliusMinimumOrderValuePlugin\Form\Extension\CompleteTypeExtension">
            <argument type="service" id="BitExpert\SyliusMinimumOrderValuePlugin\Checker\MinimumOrderValueCheckerInterface" />
            <argument type="service" id="translator" />
            <tag name="form.type_extension" />
        </service>

        <service id="BitExpert\SyliusMinimumOrderValuePlugin\Listener\MinimumOrderValueListener">
            <argument type="service" id="BitExpert\SyliusMinimumOrderValuePlugin\Checker\MinimumOrderValueCheckerInterface" />
            <tag name="kernel.event_listener" event="workflow.guard" method="guardCheckoutComplete" />
        </service>

        <service id="BitExpert\SyliusMinimumOrderValuePlugin\Twig\Extension\MinimumOrderValueExtension">
            <argument type="service" id="BitExpert\SyliusMinimumOrderValuePlugin\Checker\MinimumOrderValueCheckerInterface" />
            <argument type="service" id="sylius.context.cart" />
            <tag name="twig.extension" />
        </service>
    </services>
</container>
