{# Overrides vendor/sylius/sylius/src/Sylius/Bundle/ShopBundle/templates/checkout/complete/content/form/navigation.html.twig #}
{# Disables the "Place order" button when the order items total is below the configured minimum order value #}

{% set status = minimum_order_value_status() %}
{% set disabled = status is not null and not status.allowed %}

<div class="text-center">
    <button
        type="submit"
        id="confirmation-button"
        class="btn btn-primary"
        {{ sylius_test_html_attribute('button', 'confirmation-button') }}
        {% if disabled %}
            disabled
            aria-disabled="true"
            title="{{ status.message|trans({'%minimum_order_value%': status.minimumOrderValue|default(0)|number_format(2)}) }}"
        {% endif %}
    >
        {{ 'sylius.ui.place_order'|trans }}
    </button>
</div>
