{# Overrides vendor/sylius/sylius/src/Sylius/Bundle/ShopBundle/templates/cart/index/content/form/sections/general/checkout.html.twig #}
{# Disables the checkout button when the cart items total is below the configured minimum order value #}

{% set status = minimum_order_value_status() %}
{% set disabled = status is not null and not status.allowed %}

<div class="d-grid">
    <button
        type="submit"
        class="btn btn-primary"
        {{ sylius_test_html_attribute('cart-checkout-button') }}
        {% if disabled %}
            disabled
            aria-disabled="true"
            title="{{ status.message|trans({'%minimum_order_value%': status.minimumOrderValue|default(0)|number_format(2)}) }}"
        {% endif %}
    >
        {{ 'sylius.ui.checkout'|trans }}
    </button>
</div>
